{
  "runtimeType": "Production",
  "config": {
    "entry": [
      {
        "import": "input/app.ts",
        "name": "app"
      }
    ],
    "output": {
      "path": "output/client"
    },
    "sourceMaps": true,
    "server": {
      "entry": [
        {
          "name": "server",
          "import": "input/server.ts"
        },
        {
          "name": "index-server",
          "import": "input/index.server.ts"
        },
        {
          "name": "detail-server",
          "import": "input/detail.server.ts"
        }
      ],
      "output": {
        "path": "output/server",
        "filename": "entries/[name].[contenthash:8].js",
        "chunkFilename": "chunks/[name].[contenthash:8].js"
      }
    },
    "optimization": {
      "minify": false,
      "moduleIds": "named"
    },
    "stats": true
  }
}
