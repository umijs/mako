{
  "watch": true,
  "config": {
    "entry": [
      {
        "import": "input/index.mjs",
        "name": "main"
      }
    ],
    "mode": "development",
    "devServer": {
      "hot": true
    },
    "module": {
      "rules": {
        "**/*.js": {
          "condition": {
            "not": "foreign"
          },
          "loaders": [
            "title-loader"
          ],
          "as": "*.js"
        },
        "**/*.ts": {
          "condition": {
            "not": "foreign"
          },
          "loaders": [
            "title-loader"
          ],
          "as": "*.js"
        }
      }
    },
    "optimization": {
      "minify": false,
      "moduleIds": "named"
    },
    "sourceMaps": false
  },
  "runtimeType": "dummy"
}
