  "packageManager": "npm@11.6.2",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e:utooweb": "playwright test -c e2e/utoo-web/playwright.config.ts",
    "vitest:all": "turbo run test --filter=@utoo/pack --filter=@utoo/pack-shared",
