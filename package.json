    "clean": "turbo run clean",
    "biome": "biome check --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@playwright/test": "1.60.0",
    "husky": "^9.1.7",
    "tombi": "^0.7.32",
    "turbo": "^2.6.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/pack",
    "packages/pack-shared",
    "packages/pack-cli",
    "packages/utoo-web",
    "crates/pack-core/js",
    "crates/pack/js",
    "examples/define",
    "examples/config-js",
    "examples/externals",
    "examples/multi-entries-heavy",
    "examples/webpack-compat",
    "examples/with-antd",
    "examples/with-less",
    "examples/with-library",
    "examples/with-nodejs",
    "examples/with-sass",
    "examples/with-tailwind",
    "examples/resolve",
    "examples/with-react",
    "examples/shared-runtime-async-module",
    "examples/utooweb-demo",
